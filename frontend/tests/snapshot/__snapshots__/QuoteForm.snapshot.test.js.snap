exports[`QuoteForm — snapshots > mantiene el formulario con error de validación 1`] = `
"<form novalidate="" class="space-y-6">
  <!-- Alerta crítica de Envío Rechazado (Requisito 5.2) -->
  <!--v-if-->
  <!-- Campo A: Peso del paquete -->
  <div>
    <div class="flex items-center justify-between mb-1.5"><label for="weight_input" class="block text-sm font-semibold text-slate-800"> Peso del paquete (kg) <span class="text-rose-500">*</span></label><span class="text-xs text-slate-400 font-mono"> Rango: (0.00, 20.00] kg </span></div>
    <div class="relative"><input id="weight_input" name="weight" type="number" step="0.01" min="0" max="25" placeholder="Ej. 4.50 kg (Máx. 20.00 kg)" class="w-full px-4 py-2.5 rounded-xl border font-medium text-slate-900 placeholder:text-slate-400 focus:outline-none focus:ring-2 transition-all border-amber-400 bg-amber-50/40 focus:border-amber-500 focus:ring-amber-200 text-amber-900" aria-invalid="true" aria-describedby="weight-help weight-error" value="">
      <div class="absolute inset-y-0 right-0 pr-3.5 flex items-center pointer-events-none text-slate-400 font-medium text-sm"> kg </div>
    </div><!-- Mensaje de error de validación (Requisito 5.1, 5.3) -->
    <div id="weight-error" role="alert" class="mt-2 text-xs font-semibold text-amber-700 flex items-center gap-1.5"><svg class="w-4 h-4 shrink-0 text-amber-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"></path>
        <line x1="12" y1="9" x2="12" y2="13"></line>
        <line x1="12" y1="17" x2="12.01" y2="17"></line>
      </svg><span>El peso debe ser mayor a 0.00 kg</span></div><!-- Texto de ayuda complementario -->
    <p id="weight-help" class="mt-1.5 text-xs text-slate-500 flex items-center gap-1"><svg class="w-3.5 h-3.5 text-slate-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="12" cy="12" r="10"></circle>
        <line x1="12" y1="16" x2="12" y2="12"></line>
        <line x1="12" y1="8" x2="12.01" y2="8"></line>
      </svg><span>Ingresa un peso mayor a 0.00 kg y hasta 20.00 kg</span></p>
  </div><!-- Campo B: Tipo de cliente -->
  <div>
    <div class="flex items-center justify-between mb-2"><label class="block text-sm font-semibold text-slate-800"> Tipo de cliente </label><span class="text-xs text-slate-400"> Aplica descuento comercial </span></div>
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5"><button type="button" class="relative p-3 rounded-xl border text-left transition-all focus:outline-none focus:ring-2 focus:ring-blue-500 border-blue-600 bg-blue-50/70 shadow-xs ring-1 ring-blue-600">
        <div class="flex items-center justify-between"><span class="text-xs font-bold tracking-tight text-slate-900">NUEVO</span><span class="w-4 h-4 rounded-full border flex items-center justify-center transition-colors border-blue-600 bg-blue-600 text-white"><svg class="w-2.5 h-2.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"></polyline></svg></span></div>
        <div class="mt-1 flex items-baseline gap-1.5"><span class="text-xs font-extrabold px-1.5 py-0.5 rounded bg-slate-100 text-slate-600">0 % dto. </span></div>
        <p class="text-[11px] text-slate-500 mt-1 line-clamp-1">Cliente primerizo o esporádico</p>
      </button><button type="button" class="relative p-3 rounded-xl border text-left transition-all focus:outline-none focus:ring-2 focus:ring-blue-500 border-slate-200 bg-white hover:border-slate-300 hover:bg-slate-50/60">
        <div class="flex items-center justify-between"><span class="text-xs font-bold tracking-tight text-slate-900">FRECUENTE</span><span class="w-4 h-4 rounded-full border flex items-center justify-center transition-colors border-slate-300 bg-white"><!--v-if--></span></div>
        <div class="mt-1 flex items-baseline gap-1.5"><span class="text-xs font-extrabold px-1.5 py-0.5 rounded bg-emerald-100 text-emerald-800">10 % dto. </span></div>
        <p class="text-[11px] text-slate-500 mt-1 line-clamp-1">Envíos regulares</p>
      </button><button type="button" class="relative p-3 rounded-xl border text-left transition-all focus:outline-none focus:ring-2 focus:ring-blue-500 border-slate-200 bg-white hover:border-slate-300 hover:bg-slate-50/60">
        <div class="flex items-center justify-between"><span class="text-xs font-bold tracking-tight text-slate-900">VIP</span><span class="w-4 h-4 rounded-full border flex items-center justify-center transition-colors border-slate-300 bg-white"><!--v-if--></span></div>
        <div class="mt-1 flex items-baseline gap-1.5"><span class="text-xs font-extrabold px-1.5 py-0.5 rounded bg-emerald-100 text-emerald-800">20 % dto. </span></div>
        <p class="text-[11px] text-slate-500 mt-1 line-clamp-1">Tarifa preferencial corporativa</p>
      </button></div>
  </div><!-- Campo C: Tipo de envío -->
  <div>
    <div class="flex items-center justify-between mb-2"><label class="block text-sm font-semibold text-slate-800"> Tipo de envío </label><span class="text-xs text-slate-400"> Tiempo y prioridad </span></div>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5"><button type="button" class="relative p-3.5 rounded-xl border text-left transition-all focus:outline-none focus:ring-2 focus:ring-blue-500 border-blue-600 bg-blue-50/70 shadow-xs ring-1 ring-blue-600">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-2"><span class="text-sm font-bold text-slate-900">Estándar</span><span class="text-[10px] font-bold px-1.5 py-0.5 rounded uppercase bg-slate-100 text-slate-600 border border-slate-200">Sin recargo</span></div><span class="w-4 h-4 rounded-full border flex items-center justify-center transition-colors border-blue-600 bg-blue-600 text-white"><svg class="w-2.5 h-2.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"></polyline></svg></span>
        </div>
        <p class="text-xs text-slate-500 mt-1.5">Entrega estándar de 3 a 5 días hábiles</p>
      </button><button type="button" class="relative p-3.5 rounded-xl border text-left transition-all focus:outline-none focus:ring-2 focus:ring-blue-500 border-slate-200 bg-white hover:border-slate-300 hover:bg-slate-50/60">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-2"><span class="text-sm font-bold text-slate-900">Express</span><span class="text-[10px] font-bold px-1.5 py-0.5 rounded uppercase bg-amber-100 text-amber-800 border border-amber-200">+25% recargo</span></div><span class="w-4 h-4 rounded-full border flex items-center justify-center transition-colors border-slate-300 bg-white"><!--v-if--></span>
        </div>
        <p class="text-xs text-slate-500 mt-1.5">Entrega prioritaria en 24 a 48 horas</p>
      </button></div>
  </div><!-- Campo D: Botones de acción -->
  <div class="pt-2 flex flex-col sm:flex-row gap-3">
    <!-- Botón Principal: Calcular cotización --><button type="submit" class="flex-1 py-3 px-5 rounded-xl bg-blue-600 hover:bg-blue-700 active:bg-blue-800 text-white font-bold text-sm shadow-md shadow-blue-500/25 transition-all flex items-center justify-center gap-2 disabled:opacity-60 disabled:cursor-not-allowed focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2">
      <!-- Spinner mientras está cargando --><svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
        <path d="M5 12h14"></path>
        <path d="m12 5 7 7-7 7"></path>
      </svg><span>Calcular cotización</span>
    </button><!-- Botón Secundario: Limpiar formulario --><button type="button" class="py-3 px-4 rounded-xl border border-slate-300 hover:bg-slate-100 active:bg-slate-200 text-slate-700 font-semibold text-sm transition-all flex items-center justify-center gap-1.5 disabled:opacity-50 disabled:cursor-not-allowed focus:outline-none focus:ring-2 focus:ring-slate-400"><svg class="w-4 h-4 text-slate-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path>
        <path d="M3 3v5h5"></path>
      </svg><span>Limpiar formulario</span></button>
  </div>
</form>"
`;

